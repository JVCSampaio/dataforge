# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://dataforge:dataforge@localhost:5432/dataforge

# GitHub accounts to track (comma separated)
GITHUB_USERS=pandas-dev,fastapi-team,scikit-learn,django

# How far back to look on the FIRST run (days)
GITHUB_DAYS_BACK=30

# How many top repos per user get language breakdown fetched
GITHUB_TOP_REPOS_PER_USER=10

# Public CSV source (URL or local path)
CSV_SOURCE=https://raw.githubusercontent.com/plotly/datasets/master/gapminder.csv
