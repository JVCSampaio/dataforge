# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://dataforge:dataforge@localhost:5432/dataforge

# Optional. Raises the GitHub REST rate limit from 60 to 5000 requests per hour.
# GITHUB_TOKEN=

# GitHub accounts to track (comma separated). These match the defaults in config.py.
GITHUB_USERS=guillaumegomez,jakevdp,adamchainz

# How far back to look on the FIRST run (days)
GITHUB_DAYS_BACK=30

# How many top repos per user get a language breakdown
GITHUB_TOP_REPOS_PER_USER=10

# Public CSV source (URL or local path)
CSV_SOURCE=https://raw.githubusercontent.com/plotly/datasets/master/gapminder_unfiltered.csv

# A source older than this many hours fails the quality run.
QUALITY_MAX_AGE_HOURS=36

# Relative row-count drop that counts as an anomaly. 0.5 means 50%.
QUALITY_ROW_DROP_RATIO=0.5

# When set, `python -m dataforge quality` also writes Markdown and HTML here.
# QUALITY_REPORT_DIR=reports
